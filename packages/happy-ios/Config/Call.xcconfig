// The hosted voice agent's public ElevenLabs ID, for agent connection calls
// (HappyCore CallAgent). Never committed: a public ID lets anyone start a
// conversation billed to its owner. Set it in Call.local.xcconfig next to
// this file (ignored by git) or on the build's command line:
//     HAPPY_CALL_AGENT_ID = agent_...
// Without it, the voice button says voice isn't set up.
HAPPY_CALL_AGENT_ID =

// RevenueCat's public Apple app key, for voice's subscription (pro).
// Upstream reads EXPO_PUBLIC_REVENUE_CAT_APPLE from the environment; the
// omachala fork sells nothing (no RevenueCat, no StoreKit), so it is empty
// whatever the environment holds. Without it voice sells nothing.
HAPPY_REVENUE_CAT_APPLE_KEY =

// PostHog's project key, for the one feature flag the app reads
// (MigrationNoteFlag). The fork has no analytics: empty, so nothing is
// asked of PostHog whatever the environment holds.
HAPPY_POSTHOG_API_KEY =
#include? "Call.local.xcconfig"
